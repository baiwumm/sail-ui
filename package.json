{
  "name": "sail-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @sail-ui/playground dev",
    "dev:nuxt": "pnpm --filter nuxt-fixture dev",
    "lint": "turbo run lint && eslint tests playwright.config.ts --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json",
    "test": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:ssr": "vitest run --project ssr",
    "test:browser": "pnpm --filter @sail-ui/playground build && playwright test",
    "test:visual": "pnpm --filter @sail-ui/playground build && pnpm --filter @sail-ui/reference-react build && playwright test --config tests/visual/playwright.config.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm typecheck:tests && pnpm check:styles && pnpm check:slots && pnpm check:compat && pnpm test:contract && pnpm test && pnpm test:ssr && pnpm build",
    "gen:compat": "pnpm --filter @sail-ui/styles gen:compat",
    "check:compat": "pnpm --filter @sail-ui/styles check:compat",
    "gen:slots": "pnpm --filter @sail-ui/styles gen:slots",
    "check:slots": "pnpm --filter @sail-ui/styles check:slots",
    "sync:styles": "pnpm --filter @sail-ui/styles sync:styles",
    "check:styles": "pnpm --filter @sail-ui/styles check:styles",
    "pack:check": "node scripts/pack-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "axe-core": "4.11.0",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.12.0",
    "globals": "^16.5.0",
    "jsdom": "30.1.3",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.32",
    "postcss-selector-parser": "7.1.7",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.14"
  }
}
