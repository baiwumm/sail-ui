{
  "name": "@sail-ui/styles",
  "version": "0.0.0",
  "description": "Sail UI styles: verbatim HeroUI v3 CSS plus a generated compatibility layer",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./index.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./css": "./index.css",
    "./index.css": "./index.css",
    "./components/*.css": "./generated/components/*.css",
    "./base": "./upstream/base/base.css",
    "./base/*.css": "./upstream/base/*.css",
    "./themes/default": "./upstream/themes/default/index.css",
    "./themes/*.css": "./upstream/themes/*.css",
    "./utilities": "./upstream/utilities/index.css",
    "./variants": "./upstream/variants/index.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "./generated/**/*.css",
    "./upstream/**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "generated",
    "upstream",
    "index.css",
    "manifest.json",
    "contracts"
  ],
  "scripts": {
    "build": "pnpm gen:compat && tsup src/index.ts --format esm --dts --clean --external tailwind-variants",
    "gen:compat": "node scripts/gen-compat.mjs",
    "check:compat": "node scripts/gen-compat.mjs --check",
    "gen:slots": "node scripts/gen-data-slots.mjs",
    "check:slots": "node scripts/gen-data-slots.mjs --check",
    "sync:styles": "node scripts/sync-styles.mjs",
    "check:styles": "node scripts/sync-styles.mjs --check",
    "lint": "eslint src scripts --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "tailwind-variants": "3.3.1",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "tailwindcss": ">=4.0.0"
  },
  "devDependencies": {
    "postcss": "8.5.32",
    "postcss-selector-parser": "7.1.7",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
