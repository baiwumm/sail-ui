{
  "name": "@sail-ui/testing",
  "version": "0.0.0",
  "description": "Shared SSR, contract, and visual test helpers for Sail UI",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external vue --external @vue/server-renderer",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@vue/server-renderer": "^3.5.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/pngjs": "6.0.5",
    "@vue/server-renderer": "3.5.44",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vue": "3.5.44"
  },
  "dependencies": {
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0"
  }
}
